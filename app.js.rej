+    if (statusEl) {
+        statusEl.textContent = alertData.position || 'Hàng đợi';
+    }
+    
+    alertBox.classList.add('active');
+    
     if (dbAlertTimeout) clearTimeout(dbAlertTimeout);
     dbAlertTimeout = setTimeout(() => {
