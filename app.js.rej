+let tftRankCache = null;
+let tftRankLoading = false;
+let tftRankCountdownInterval = null;
+let tftRankCountdown = 300; // 5 minutes in seconds
+
+// Biến quản lý thời gian mạng và đếm ngược hạn chót
+let networkTimeAtLoad = null;
+let performanceTimeAtLoad = null;
+const TARGET_DEADLINE = 1782147540000; // Hạn chót: 23:59:00 ngày 22/06/2026 GMT+7 (7 ngày kể từ 23:59 ngày 15/06/2026)
+let deadlineCountdownInterval = null;
+
+async function syncNetworkTime() {
+    try {
+        if (window.electronAPI && typeof window.electronAPI.getNetworkTime === 'function') {
+            const netTime = await window.electronAPI.getNetworkTime();
+            networkTimeAtLoad = netTime;
+            performanceTimeAtLoad = performance.now();
+            console.log(`Renderer: Đồng bộ thời gian mạng thành công: ${new Date(netTime).toLocaleString('vi-VN')}`);
+        } else {
+            networkTimeAtLoad = Date.now();
+            performanceTimeAtLoad = performance.now();
+        }
+    } catch (e) {
+        console.error("Renderer: Lỗi đồng bộ thời gian mạng, fallback sang giờ hệ thống:", e);
+        networkTimeAtLoad = Date.now();
+        performanceTimeAtLoad = performance.now();
+    }
+}
+
+function getCurrentNetworkTime() {
+    if (networkTimeAtLoad !== null && performanceTimeAtLoad !== null) {
+        return networkTimeAtLoad + (performance.now() - performanceTimeAtLoad);
+    }
+    return Date.now();
+}
+
+function getDeadlineTimeLeft() {
+    const nowNet = getCurrentNetworkTime();
+    return TARGET_DEADLINE - nowNet;
+}
+
+function startDeadlineCountdown() {
+    stopDeadlineCountdown();
+    updateDeadlineCountdownUI();
+    deadlineCountdownInterval = setInterval(updateDeadlineCountdownUI, 1000);
+}
+
+function stopDeadlineCountdown() {
+    if (deadlineCountdownInterval) {
+        clearInterval(deadlineCountdownInterval);
+        deadlineCountdownInterval = null;
+    }
+}
+
+function updateDeadlineCountdownUI() {
+    const displayEls = document.querySelectorAll('.deadline-countdown-display');
+    if (displayEls.length === 0) return;
+
+    const diff = getDeadlineTimeLeft();
+    if (diff <= 0) {
+        stopDeadlineCountdown();
+        displayEls.forEach(el => el.textContent = "00:00:00:00");
+        loadAfterCreditText(true);
+        return;
+    }
+
+    const secs = Math.floor(diff / 1000);
+    const days = Math.floor(secs / (24 * 3600));
+    const hours = Math.floor((secs % (24 * 3600)) / 3600);
+    const mins = Math.floor((secs % 3600) / 60);
+    const remainingSecs = secs % 60;
+
+    const daysStr = days.toString().padStart(2, '0');
+    const hoursStr = hours.toString().padStart(2, '0');
+    const minsStr = mins.toString().padStart(2, '0');
+    const secsStr = remainingSecs.toString().padStart(2, '0');
+    const text = `${daysStr}:${hoursStr}:${minsStr}:${secsStr}`;
+    
+    displayEls.forEach(el => el.textContent = text);
+}
+
+function startTftRankCountdown() {
+    stopTftRankCountdown();
+    if (tftRankCountdown <= 0) {
+        tftRankCountdown = 300;
+    }
+    tftRankCountdownInterval = setInterval(() => {
+        tftRankCountdown--;
+        const countdownEl = document.getElementById('aftercredit-countdown');
+        if (countdownEl) {
+            const minutes = Math.floor(tftRankCountdown / 60);
+            const seconds = tftRankCountdown % 60;
+            const timeStr = minutes > 0 ? `${minutes} phút ${seconds} giây` : `${seconds} giây`;
+            countdownEl.textContent = `Tự động cập nhật sau ${timeStr}`;
+        }
+        if (tftRankCountdown <= 0) {
+            tftRankCountdown = 300;
+            loadAfterCreditText(true);
+        }
+    }, 1000);
+}
+
+function stopTftRankCountdown() {
+    if (tftRankCountdownInterval) {
+        clearInterval(tftRankCountdownInterval);
+        tftRankCountdownInterval = null;
+    }
+}
+
+async function preloadAfterCreditData() {
+    console.log("Renderer: Bắt đầu preload dữ liệu After Credit...");
+    
+    // 1. Đồng bộ thời gian mạng
+    await syncNetworkTime();
+    
+    // 2. Fetch TFT Rank lần đầu tiên
+    try {
+        if (window.electronAPI && typeof window.electronAPI.getTftRank === 'function') {
+            const res = await window.electronAPI.getTftRank();
+            if (res && !res.error) {
+                tftRankCache = res;
+                console.log(`Renderer: Preload rank TFT thành công: ${res.tier} ${res.lp} LP`);
+            } else {
+                console.error('Renderer: Lỗi preload rank TFT:', res ? res.error : 'Unknown');
+            }
+        }
+    } catch (err) {
+        console.error('Renderer: Lỗi khi preload rank TFT:', err);
+    }
+    
+    // 3. Khởi chạy các bộ đếm ngược chạy ngầm liên tục
+    startTftRankCountdown();
+    startDeadlineCountdown();
+    
+    // 4. Nếu tab hiện tại đang hoạt động là 'aftercredit', vẽ lại giao diện
+    const activeTab = document.querySelector('.settings-tab-btn.active');
+    if (activeTab && activeTab.getAttribute('onclick') && activeTab.getAttribute('onclick').includes('aftercredit')) {
+        loadAfterCreditText();
+    }
+}
+
+async function submitAfterCreditPassword() {
+    const input = document.getElementById('aftercredit-pw-input');
+    const errorEl = document.getElementById('aftercredit-pw-error');
+    if (!input) return;
+
+    if (localStorage.getItem('dua_aftercredit_pw_used') === 'true') {
+        if (errorEl) {
+            errorEl.textContent = 'Mật mã này chỉ được phép sử dụng duy nhất một lần.';
+            errorEl.style.display = 'block';
+        }
+        return;
+    }
+
+    const pw = input.value.trim();
+    if (!pw) return;
+
+    try {
+        if (window.electronAPI && typeof window.electronAPI.verifyAfterCreditPassword === 'function') {
+            const res = await window.electronAPI.verifyAfterCreditPassword(pw);
+            if (res && res.success) {
+                alert("After Credit chỉ được mở 1 lần duy nhất, mong chị hãy đọc nó");
+                localStorage.setItem('dua_aftercredit_pw_used', 'true');
+                localStorage.setItem('dua_aftercredit_unlocked_by_password', 'true');
+                if (errorEl) errorEl.style.display = 'none';
+                loadAfterCreditText();
+            } else {
+                if (errorEl) {
+                    errorEl.textContent = 'Mật mã không chính xác';
+                    errorEl.style.display = 'block';
+                }
+            }
+        } else {
+            // Fallback cho môi trường test ko có Electron backend
+            if (pw === '2810200324101999') {
+                alert("After Credit chỉ được mở 1 lần duy nhất, mong chị hãy đọc nó");
+                localStorage.setItem('dua_aftercredit_pw_used', 'true');
+                localStorage.setItem('dua_aftercredit_unlocked_by_password', 'true');
+                if (errorEl) errorEl.style.display = 'none';
+                loadAfterCreditText();
+            } else {
+                if (errorEl) {
+                    errorEl.textContent = 'Mật mã không chính xác';
+                    errorEl.style.display = 'block';
+                }
+            }
+        }
+    } catch (err) {
+        console.error('Lỗi khi xác minh mật khẩu:', err);
+    }
+}
+
+function toggleContentProtection(enable) {
+    if (window.electronAPI && typeof window.electronAPI.setContentProtection === 'function') {
+        window.electronAPI.setContentProtection(enable);
+        console.log(`Renderer: Yêu cầu content protection = ${enable}`);
+    }
+}
+
+function preventAfterCreditDefault(e) {
+    e.preventDefault();
+    return false;
+}
+
+function applyAfterCreditSecurity() {
+    const container = document.querySelector('.aftercredit-letter-container');
+    if (!container) return;
+
+    // Chặn Context Menu (chuột phải)
+    container.addEventListener('contextmenu', preventAfterCreditDefault);
+
+    // Chặn các sự kiện copy, cut, paste
+    container.addEventListener('copy', preventAfterCreditDefault);
+    container.addEventListener('cut', preventAfterCreditDefault);
+    container.addEventListener('paste', preventAfterCreditDefault);
+
+    // Chặn sự kiện kéo thả chuột để chọn hoặc kéo ảnh
+    container.addEventListener('dragstart', preventAfterCreditDefault);
+    container.addEventListener('selectstart', preventAfterCreditDefault);
+}
+
+function afterCreditKeydownListener(e) {
+    // Nếu đang ở tab settings và section aftercredit, chặn các phím tắt sao chép/in ấn/dev tools
+    const activeTab = document.querySelector('.tab-content.active');
+    const afterCreditSec = document.getElementById('settings-sec-aftercredit');
+    const isAfterCreditActive = activeTab && activeTab.id === 'tab-settings' && 
+                               afterCreditSec && afterCreditSec.style.display !== 'none';
+                               
+    if (isAfterCreditActive) {
+        // Chặn Ctrl+C, Ctrl+X, Ctrl+A, Ctrl+P (In), Ctrl+S (Lưu), Ctrl+U (Mã nguồn), F12, Ctrl+Shift+I (DevTools)
+        if (
+            (e.ctrlKey && ['c', 'x', 'a', 'p', 'u', 's'].includes(e.key.toLowerCase())) ||
+            e.key === 'F12' ||
+            (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'i')
+        ) {
+            e.preventDefault();
+            return false;
+        }
+    }
+}
+
+// Đăng ký bộ lắng nghe phím tắt toàn cục
+window.addEventListener('keydown', afterCreditKeydownListener);
+
+function checkAfterCreditStatus() {
+    const divider = document.getElementById('aftercredit-sidebar-divider');
+    const button = document.getElementById('aftercredit-sidebar-btn');
+    if (localStorage.getItem('dua_aftercredit_first_choice_declined') === 'true') {
+        if (divider) divider.style.display = 'none';
+        if (button) button.style.display = 'none';
+    } else {
+        if (divider) divider.style.display = '';
+        if (button) button.style.display = '';
+    }
+}
+
+function acceptAfterCredit() {
+    localStorage.setItem('dua_aftercredit_first_choice_made', 'true');
+    loadAfterCreditText(true);
+}
+
+function declineAfterCredit() {
+    localStorage.setItem('dua_aftercredit_first_choice_declined', 'true');
+    checkAfterCreditStatus();
+    switchSettingsSection('sync'); // Quay về tab đồng bộ
+}
+
+function confirmOpenAfterCredit() {
+    alert("After Credit chỉ được mở 1 lần duy nhất, mong chị hãy đọc nó");
+    localStorage.setItem('dua_aftercredit_lp_unlocked_confirmed', 'true');
+    loadAfterCreditText();
+}
+
+function getTftRankVietnamese(tier) {
+    if (!tier) return "Chưa xếp hạng";
+    
+    const parts = tier.toUpperCase().trim().split(/\s+/);
+    const mainTier = parts[0];
+    const division = parts[1] || "";
+    
+    const rankMapping = {
+        'IRON': 'Sắt',
+        'BRONZE': 'Đồng',
+        'SILVER': 'Bạc',
+        'GOLD': 'Vàng',
+        'PLATINUM': 'Bạch Kim',
+        'EMERALD': 'Lục Bảo',
+        'DIAMOND': 'Kim Cương',
+        'MASTER': 'Cao Thủ',
+        'GRANDMASTER': 'Đại Cao Thủ',
+        'CHALLENGER': 'Thách Đấu'
+    };
+    
+    const translatedTier = rankMapping[mainTier] || mainTier;
+    
+    // Master, Đại Cao Thủ, Thách Đấu không có đoàn (division) trong ĐTCL, nên lược bỏ nếu có "I"
+    const isMasterOrAbove = ['MASTER', 'GRANDMASTER', 'CHALLENGER'].includes(mainTier);
+    if (division && !isMasterOrAbove) {
+        return `${translatedTier} ${division}`;
+    }
+    return translatedTier;
+}
+
+// --- TẢI VÀ PHÂN TÍCH VĂN BẢN AFTER CREDIT ---
+async function loadAfterCreditText(forceRefresh = false) {
+    const container = document.querySelector('.aftercredit-letter-container');
+    if (!container) return;
+
+    // 00. Kiểm tra lựa chọn đầu tiên (Ready / Decline)
+    const isFirstChoiceMade = localStorage.getItem('dua_aftercredit_first_choice_made') === 'true';
+    if (isFirstChoiceMade) {
+        if (window.afterCreditLockInterval) {
+            clearInterval(window.afterCreditLockInterval);
+            window.afterCreditLockInterval = null;
+        }
+    } else {
+        stopTftRankCountdown();
+        stopDeadlineCountdown();
+
+        // Đồng bộ thời gian mạng nếu chưa có để hiển thị thời gian chính xác
+        if (networkTimeAtLoad === null) {
+            await syncNetworkTime();
+        }
+
+        const unlockTimestamp = 1781888400000; // 00:00:00 ngày 20/06/2026 GMT+7 (sau ngày 19/06)
+        const nowNet = getCurrentNetworkTime();
+        const isLocked = nowNet < unlockTimestamp;
+
+        // Định nghĩa HTML cho phần Question / Locked
+        let questionHtml = '';
+        if (isLocked) {
+            questionHtml = `
+                <div id="aftercredit-question-section" style="max-width: 580px; text-align: center; scroll-margin-top: 2rem; width: 100%;">
+                    <div style="padding: 2.2rem 2rem; border-radius: 16px; background: rgba(0,0,0,0.02); border: 2px dashed var(--pineapple-border-color); display: flex; flex-direction: column; align-items: center; gap: 0.8rem; box-sizing: border-box;">
+                        <div style="font-size: 0.95rem; color: var(--text-color-secondary); font-weight: 600;">Nếu chị vẫn muốn tiếp tục thì hãy quay trở lại sau vài ngày tới nhé</div>
+                        <div style="margin-top: 0.5rem; text-align: center; font-size: 0.9rem; color: var(--text-color-secondary); font-weight: 700; line-height: 1.6;">
+                            Thời gian còn lại: 
+                            <span id="aftercredit-firstchoice-countdown" style="font-family: var(--font-title); font-size: 1.25rem; font-weight: 900; color: var(--pineapple-orange-dark); margin: 0 0.3rem;">
+                                Đang tính toán...
+                            </span>
+                        </div>
+                    </div>
+                </div>
+            `;
+        } else {
+            questionHtml = `
+                <div id="aftercredit-question-section" style="max-width: 580px; text-align: center; scroll-margin-top: 2rem; width: 100%;">
+                    <p style="font-family: var(--font-primary); font-size: 1.1rem; line-height: 1.75; color: var(--pineapple-text); margin-bottom: 2.2rem; font-weight: 600; text-align: center; white-space: pre-wrap;">Chưa bao giờ em thấy mọi thứ xa xôi và mơ hồ đến thế. Em không hiểu chị, cũng chẳng còn hiểu nổi mình đang chờ đợi điều gì. Mọi thứ cứ như bị phủ bởi một màn sương dày, nhìn đâu cũng chỉ thấy mù mịt. After Credit này chỉ là tâm sự nhỏ của em. Nếu chị thực sự muốn đọc… thì có lẽ em chỉ muốn thấy chị cố gắng, dù chỉ một chút, để em biết rằng tất cả những điều này chưa hoàn toàn vô nghĩa.</p>
+                    <div style="display: flex; gap: 1.2rem; justify-content: center; width: 100%;">
+                        <button class="dua-btn dua-btn-primary" onclick="acceptAfterCredit()">
+                            Sẵn sàng chứ
+                        </button>
+                        <button class="dua-btn dua-btn-secondary" onclick="declineAfterCredit()">
+                            Thôi
+                        </button>
+                    </div>
+                </div>
+            `;
+        }
+
+        container.innerHTML = `
+            <style>
+                @keyframes bounce-arrow {
+                    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
+                    40% { transform: translateY(-10px); }
+                    60% { transform: translateY(-5px); }
+                }
+                .aftercredit-bouncing-arrow {
+                    display: inline-block;
+                    animation: bounce-arrow 2s infinite;
+                }
+            </style>
+            <div class="aftercredit-choice-wrapper" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem 1.5rem; text-align: center; font-family: var(--font-primary); width: 100%; box-sizing: border-box;">
+                <!-- Đoạn mở đầu tiên -->
+                <div style="max-width: 580px; text-align: center; margin-bottom: 2rem;">
+                    <p style="font-family: var(--font-primary); font-size: 1.1rem; line-height: 1.75; color: var(--pineapple-text); font-weight: 600; margin-bottom: 1.5rem; white-space: pre-wrap; text-align: center;">Giờ nhìn chị vui vẻ bên mọi người, được rất nhiều người yêu thương và luôn nhận về sự ủng hộ, em thật sự thấy mừng cho chị.</p>
+                    <p style="font-family: var(--font-primary); font-size: 1.1rem; line-height: 1.75; color: var(--pineapple-text); font-weight: 600; margin-bottom: 1.5rem; white-space: pre-wrap; text-align: center;">Nhìn chị như vậy, em càng nhận ra vốn dĩ chẳng có lý do gì để em kéo chị vào câu chuyện đầy tiêu cực của riêng mình cả. Có lẽ từ đầu đến cuối, những cảm xúc này vẫn nên là điều em tự giữ lấy.</p>
+                    <p style="font-family: var(--font-primary); font-size: 1.1rem; line-height: 1.75; color: var(--pineapple-text); font-weight: 600; margin-bottom: 1.5rem; white-space: pre-wrap; text-align: center;">Em cảm ơn chị rất nhiều, vì đã từng quan tâm đến cảm xúc của em, dù chỉ là những điều nhỏ bé.</p>
+                    <p style="font-family: var(--font-primary); font-size: 1.1rem; line-height: 1.75; color: var(--pineapple-text); font-weight: 600; margin-bottom: 0; white-space: pre-wrap; text-align: center;">After credit này là thứ em đã dành rất nhiều tâm sức để hoàn thành, đơn giản chỉ để nói ra những cảm xúc thật nhất của mình. Nhưng có lẽ… sau tất cả, em nên dừng lại ở đây.</p>
+                </div>
+
+                <!-- Dấu mũi tên bắt đầu được giấu kín ở 1 đoạn xa -->
+                <div style="height: 800px; width: 100%;"></div>
+                
+                <div class="aftercredit-bouncing-arrow" style="margin-bottom: 2rem; font-size: 2rem; color: var(--pineapple-orange-dark); cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;" onclick="document.getElementById('aftercredit-question-section').scrollIntoView({ behavior: 'smooth' })">
+                    <i class="fa-solid fa-angles-down"></i>
+                    <span style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--text-color-secondary); margin-top: 0.5rem;">Cuộn tiếp để bắt đầu</span>
+                </div>
+
+                <!-- Giao diện câu hỏi / hoặc giao diện khóa -->
+                ${questionHtml}
+            </div>
+        `;
+
+        // Nếu đang khóa, chạy interval cập nhật đếm ngược
+        if (isLocked) {
+            if (window.afterCreditLockInterval) clearInterval(window.afterCreditLockInterval);
+            
+            const updateLockCountdown = () => {
+                const now = getCurrentNetworkTime();
+                const diff = unlockTimestamp - now;
+                const countdownEl = document.getElementById('aftercredit-firstchoice-countdown');
+                if (!countdownEl) {
+                    clearInterval(window.afterCreditLockInterval);
+                    return;
+                }
+                
+                if (diff <= 0) {
+                    clearInterval(window.afterCreditLockInterval);
+                    loadAfterCreditText(true); // reload lại để hiện câu hỏi
+                    return;
+                }
+                
+                const secs = Math.floor(diff / 1000);
+                const days = Math.floor(secs / (24 * 3600));
+                const hours = Math.floor((secs % (24 * 3600)) / 3600);
+                const mins = Math.floor((secs % 3600) / 60);
+                const remainingSecs = secs % 60;
+                
+                const daysStr = days.toString().padStart(2, '0');
+                const hoursStr = hours.toString().padStart(2, '0');
+                const minsStr = mins.toString().padStart(2, '0');
+                const secsStr = remainingSecs.toString().padStart(2, '0');
+                
+                countdownEl.textContent = `${daysStr}:${hoursStr}:${minsStr}:${secsStr}`;
+            };
+            
+            updateLockCountdown();
+            window.afterCreditLockInterval = setInterval(updateLockCountdown, 1000);
+        } else {
+            if (window.afterCreditLockInterval) {
+                clearInterval(window.afterCreditLockInterval);
+                window.afterCreditLockInterval = null;
+            }
+        }
+        return;
+    }
+
+    // Đồng bộ thời gian mạng nếu chưa có hoặc khi buộc tải lại
+    if (networkTimeAtLoad === null || forceRefresh) {
+        await syncNetworkTime();
+    }
+
+    // 0. Kiểm tra xem đã đọc thư chưa (chỉ được đọc 1 lần duy nhất)
+    const isViewed = localStorage.getItem('dua_aftercredit_viewed') === 'true';
+    if (isViewed) {
+        stopTftRankCountdown();
+        stopDeadlineCountdown();
+        const readFully = localStorage.getItem('dua_aftercredit_read_fully') === 'true';
+        const descText = readFully 
+            ? "Hoặc là may chị đã kiên nhẫn đọc hết nó, em cảm ơn nhìu"
+            : "Hoặc là tiếc là chị đã không coi trọng nó.";
+            
+        container.innerHTML = `
+            <div class="aftercredit-lock-wrapper" style="padding: 2rem; border-radius: 16px; background: rgba(0,0,0,0.02); border: 2px dashed var(--pineapple-border-color);">
+                <div class="aftercredit-lock-title" style="font-size: 1.25rem; font-weight: 800; color: var(--pineapple-text); margin-bottom: 0.5rem;">Nó chỉ hiển thị một lần duy nhất</div>
+                <div class="aftercredit-lock-desc" style="font-size: 1rem; color: var(--pineapple-orange-dark); font-weight: 600;">
+                    ${descText}
+                </div>
+            </div>
+        `;
+        return;
+    }
+
+    // 0.5. Kiểm tra thời hạn chót 10 ngày
+    const deadlineDiff = getDeadlineTimeLeft();
+    const isUnlockedByPassword = localStorage.getItem('dua_aftercredit_unlocked_by_password') === 'true';
+    const lpUnlocked = tftRankCache && tftRankCache.unlocked;
+    const lpConfirmed = localStorage.getItem('dua_aftercredit_lp_unlocked_confirmed') === 'true';
+    const isActuallyUnlocked = lpUnlocked || lpConfirmed || isUnlockedByPassword;
+    
+    if (deadlineDiff <= 0 && !isActuallyUnlocked) {
+        stopTftRankCountdown();
+        stopDeadlineCountdown();
+        const showPwForm = localStorage.getItem('dua_aftercredit_pw_used') !== 'true';
+        container.innerHTML = `
+            <div class="aftercredit-lock-wrapper" style="padding: 2rem; border-radius: 16px; background: rgba(0,0,0,0.02); border: 2px dashed var(--pineapple-border-color);">
+                <div class="aftercredit-lock-title" style="font-size: 1.25rem; font-weight: 800; color: var(--pineapple-text); margin-bottom: 0.5rem;">Đã quá thời hạn mở khóa</div>
+                <div class="aftercredit-lock-desc" style="white-space: pre-wrap; line-height: 1.6; max-width: 550px; text-align: center; margin-bottom: 1.5rem; font-size: 0.95rem;">Thật đáng tiếc, chị không hoàn thành được đó rồi, lí do là gì ấy nhỉ. Chị cũng không tò mò xem em nói gì hay sao? Thoi dù sao em cũng hiểu chị mà.</div>
+                
+                ${showPwForm ? `
+                <div class="aftercredit-password-box" style="margin-bottom: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; width: 100%; max-width: 320px;">
+                    <div style="display: flex; gap: 0.5rem; width: 100%;">
+                        <input type="password" id="aftercredit-pw-input" class="aftercredit-pw-input" placeholder="Nhập mật mã bí mật...">
+                        <button class="aftercredit-pw-submit" onclick="submitAfterCreditPassword()">Mở khóa</button>
+                    </div>
+                    <div id="aftercredit-pw-error" style="color: #ff4d4d; font-size: 0.85rem; font-weight: 600; display: none; margin-top: 0.2rem;">Mật mã không chính xác</div>
+                </div>
+                ` : ''}
+            </div>
+        `;
+        
+        if (showPwForm) {
+            const inputEl = document.getElementById('aftercredit-pw-input');
+            if (inputEl) {
+                inputEl.addEventListener('keyup', (e) => {
+                    if (e.key === 'Enter') submitAfterCreditPassword();
+                });
+            }
+        }
+        return;
+    }
+
+    if (isUnlockedByPassword) {
+        // Tiếp tục phần 4 để đọc file trực tiếp
+    } else {
+        // 2. Nếu chưa có cache hoặc buộc tải lại
+        if (!tftRankCache || forceRefresh) {
+            if (tftRankLoading) return;
+            tftRankLoading = true;
+            
+            container.innerHTML = `
+                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 200px; gap: 0.8rem; font-weight: 600;">
+                    <i class="fa-solid fa-spinner fa-spin" style="font-size: 2rem; color: var(--pineapple-orange);"></i>
+                    <span>Đang kết nối API tra cứu rank TFT của Em Dứa...</span>
+                </div>
+            `;
+
+            try {
+                if (window.electronAPI && typeof window.electronAPI.getTftRank === 'function') {
+                    const res = await window.electronAPI.getTftRank();
+                    if (res && !res.error) {
+                        tftRankCache = res;
+                    } else {
+                        console.error('Lỗi khi get TFT rank:', res ? res.error : 'Unknown error');
+                        if (!tftRankCache) {
+                            const showPwForm = localStorage.getItem('dua_aftercredit_pw_used') !== 'true';
+                            container.innerHTML = `
+                                <div class="aftercredit-lock-wrapper" style="padding: 2rem; border-radius: 16px; background: rgba(0,0,0,0.02); border: 2px dashed var(--pineapple-border-color);">
+                                    <div class="aftercredit-lock-title" style="font-size: 1.25rem; font-weight: 800; color: var(--pineapple-text); margin-bottom: 0.5rem;">Không thể kết nối API TFT</div>
+                                    <div class="aftercredit-lock-desc" style="font-size: 0.95rem;">Đã xảy ra lỗi khi tải thông tin rank từ hệ thống API TFT (${res ? res.error : 'Lỗi mạng'}). Vui lòng kiểm tra lại kết nối internet.</div>
+                                    
+                                    <div style="margin-top: 0.5rem; margin-bottom: 1.5rem; text-align: center; font-size: 0.9rem; color: var(--text-color-secondary); font-weight: 600; line-height: 1.6; max-width: 500px;">
+                                        Thời gian để after credit cho phép mở khoá: 
+                                        <span class="deadline-countdown-display" style="font-family: var(--font-title); font-size: 1.15rem; font-weight: 900; color: var(--pineapple-orange-dark); margin: 0 0.3rem;">
+                                            Đang tính toán...
+                                        </span> 
+                                        sau khoảng thời gian đó thì nó sẽ không còn mở được nữa
+                                    </div>
+
+                                    ${showPwForm ? `
+                                    <div style="margin: 0.8rem 0; opacity: 0.5; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--text-color-secondary);">Hoặc</div>
+
+                                    <div class="aftercredit-password-box" style="margin-bottom: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; width: 100%; max-width: 320px;">
+                                        <div style="display: flex; gap: 0.5rem; width: 100%;">
+                                            <input type="password" id="aftercredit-pw-input" class="aftercredit-pw-input" placeholder="Nhập mật mã bí mật...">
+                                            <button class="aftercredit-pw-submit" onclick="submitAfterCreditPassword()">Mở khóa</button>
+                                        </div>
+                                        <div id="aftercredit-pw-error" style="color: #ff4d4d; font-size: 0.85rem; font-weight: 600; display: none; margin-top: 0.2rem;">Mật mã không chính xác</div>
+                                    </div>
+                                    ` : ''}
+
+                                    <div id="aftercredit-countdown" style="font-size: 0.85rem; color: var(--text-color-secondary); opacity: 0.85; font-weight: 500; margin-top: 1.5rem;">
+                                        Tự động cập nhật sau 5 phút
+                                    </div>
+                                </div>
+                            `;
+                            if (showPwForm) {
+                                const inputEl = document.getElementById('aftercredit-pw-input');
+                                if (inputEl) {
+                                    inputEl.addEventListener('keyup', (e) => {
+                                        if (e.key === 'Enter') submitAfterCreditPassword();
+                                    });
+                                }
+                            }
+                            startDeadlineCountdown();
+                            tftRankLoading = false;
+                            return;
+                        }
+                    }
+                } else {
+                    tftRankCache = {
+                        tier: 'CHALLENGER I',
+                        lp: 906,
+                        unlocked: false
+                    };
+                }
+            } catch (err) {
+                console.error('Error fetching TFT rank:', err);
+            } finally {
+                tftRankLoading = false;
+            }
+        }
+
+        // 3. Xử lý hiển thị dựa trên trạng thái rank (đã đạt mốc 1200 LP chưa)
+        if (tftRankCache && !tftRankCache.unlocked) {
+            const currentLP = tftRankCache.lp || 0;
+            const targetLP = 1200;
+            const neededLP = targetLP - currentLP;
+            const progressPercent = Math.min(100, Math.max(0, (currentLP / targetLP) * 100));
+            
+            const minutes = Math.floor(tftRankCountdown / 60);
+            const seconds = tftRankCountdown % 60;
+            const timeStr = minutes > 0 ? `${minutes} phút ${seconds} giây` : `${seconds} giây`;
+
+            const showPwForm = localStorage.getItem('dua_aftercredit_pw_used') !== 'true';
+
+            container.innerHTML = `
+                <div class="aftercredit-lock-wrapper" style="padding: 2rem; border-radius: 16px; background: rgba(0,0,0,0.02); border: 2px dashed var(--pineapple-border-color);">
+                    <div class="aftercredit-lock-title" style="font-size: 1.25rem; font-weight: 800; color: var(--pineapple-text); margin-bottom: 0.5rem;">Hiện tại chị chưa thể đọc nó</div>
+                    <div class="aftercredit-lock-desc" style="font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.6;">
+                        Xưa em đã hứa là em sẽ bỏ chị khi chị không được 1200LP đến cuối mùa, nhưng giờ vì em đã không còn bỏ chị nữa, nên nếu chị tò mò, 1200LP là đủ để mở nó. Trong đây là những thứ em chưa từng tiết lộ cùng 1 vài tâm sự nữa.<br>
+                        Rất dễ đối với chị đúng không nào
+                    </div>
+
+                    <div style="margin-top: 0.5rem; margin-bottom: 1.5rem; text-align: center; font-size: 0.9rem; color: var(--text-color-secondary); font-weight: 600; line-height: 1.6; max-width: 500px;">
+                        Thời gian để after credit cho phép mở khoá: 
+                        <span class="deadline-countdown-display" style="font-family: var(--font-title); font-size: 1.15rem; font-weight: 900; color: var(--pineapple-orange-dark); margin: 0 0.3rem;">
+                            Đang tính toán...
+                        </span> 
+                        sau khoảng thời gian đó thì nó sẽ không còn mở được nữa
+                    </div>
+                    
+                    <div class="aftercredit-progress-box">
+                        <div class="aftercredit-progress-text">
+                            <span>Tiến trình: ${currentLP} / ${targetLP} LP</span>
+                            <span>Còn thiếu ${neededLP} LP</span>
+                        </div>
+                        <div class="aftercredit-progress-bar-bg">
+                            <div class="aftercredit-progress-bar-fill" style="width: ${progressPercent}%"></div>
+                        </div>
+                    </div>
+
+                    <div style="font-size: 0.85rem; color: var(--text-color-secondary); margin-bottom: 0.5rem; opacity: 0.8;">
+                        Rank hiện tại: <strong>${getTftRankVietnamese(tftRankCache.tier)} ${currentLP} LP</strong>
+                    </div>
+
+                    ${showPwForm ? `
+                    <div style="margin: 0.8rem 0; opacity: 0.5; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--text-color-secondary);">Hoặc</div>
+
+                    <div class="aftercredit-password-box" style="margin-bottom: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; width: 100%; max-width: 320px;">
+                        <div style="display: flex; gap: 0.5rem; width: 100%;">
+                            <input type="password" id="aftercredit-pw-input" class="aftercredit-pw-input" placeholder="Nhập mật mã bí mật...">
+                            <button class="aftercredit-pw-submit" onclick="submitAfterCreditPassword()">Mở khóa</button>
+                        </div>
+                        <div id="aftercredit-pw-error" style="color: #ff4d4d; font-size: 0.85rem; font-weight: 600; display: none; margin-top: 0.2rem;">Mật mã không chính xác</div>
+                    </div>
+                    ` : ''}
+
+                    <div id="aftercredit-countdown" style="font-size: 0.85rem; color: var(--text-color-secondary); opacity: 0.85; font-weight: 500;">
+                        Tự động cập nhật sau ${timeStr}
+                    </div>
+                </div>
+            `;
+            
+            if (showPwForm) {
+                const inputEl = document.getElementById('aftercredit-pw-input');
+                if (inputEl) {
+                    inputEl.addEventListener('keyup', (e) => {
+                        if (e.key === 'Enter') submitAfterCreditPassword();
+                    });
+                }
+            }
+
+            startDeadlineCountdown();
+
+            setTimeout(() => {
+                const fill = container.querySelector('.aftercredit-progress-bar-fill');
+                if (fill) fill.style.width = `${progressPercent}%`;
+            }, 50);
+            return;
+        }
+
+        // 3.5. Đã đạt 1200 LP nhưng chưa bấm xác nhận mở thư
+        if (tftRankCache && tftRankCache.unlocked && localStorage.getItem('dua_aftercredit_lp_unlocked_confirmed') !== 'true') {
+            const currentLP = tftRankCache.lp || 0;
+            container.innerHTML = `
+                <div class="aftercredit-lock-wrapper" style="padding: 2rem; border-radius: 16px; background: rgba(0,0,0,0.02); border: 2px dashed var(--pineapple-border-color);">
+                    <div class="aftercredit-lock-title" style="font-size: 1.25rem; font-weight: 800; color: var(--pineapple-text); margin-bottom: 0.5rem;">Chúc mừng chị đã đạt mốc 1200 LP</div>
+                    <div class="aftercredit-lock-desc" style="font-size: 0.95rem; line-height: 1.6;">
+                        Chị đã đủ điều kiện để mở bức thư tâm sự After Credit.<br>
+                        <strong style="color: var(--pineapple-orange-dark); display: block; margin-top: 0.5rem; font-size: 0.9rem;">
+                            Sau khi đạt 1200 điểm, after credit chỉ được mở 1 lần duy nhất.
+                        </strong>
+                    </div>
+                    
+                    <div style="font-size: 0.85rem; color: var(--text-color-secondary); margin-bottom: 1.5rem; opacity: 0.8; font-weight: 700;">
+                        Rank hiện tại của chị: <strong>${getTftRankVietnamese(tftRankCache.tier)} ${currentLP} LP</strong>
+                    </div>
+
+                    <button class="aftercredit-pw-submit" onclick="confirmOpenAfterCredit()" style="padding: 0.6rem 2rem; border-radius: 12px; font-size: 0.95rem; font-weight: 800; cursor: pointer;">
+                        Mở thư
+                    </button>
+                </div>
+            `;
+            return;
+        }
+    }
+
+    // 4. Nếu đã mở khóa (unlocked === true hoặc đã nhập pass), đọc tệp mã hóa/giải mã và hiển thị
+    try {
+        let text = '';
+        if (window.electronAPI && typeof window.electronAPI.readAfterCredit === 'function') {
+            text = await window.electronAPI.readAfterCredit();
+        } else {
+            // Fallback cho môi trường trình duyệt kiểm thử (dev)
+            const response = await fetch('after_credit.txt');
+            text = await response.text();
+        }
+        
+        container.innerHTML = '';
+        
+        if (!text) {
+            container.innerHTML = '<p>Không thể đọc nội dung thư After Credit.</p>';
+            return;
+        }
+
+        // Bật bảo mật chống sao chép và chụp màn hình
+        toggleContentProtection(true);
+
+        // Tắt countdown khi đã xem để tránh lặp lại kiểm tra không cần thiết
+        stopTftRankCountdown();
+        stopDeadlineCountdown();
+
+        // Đánh dấu đã xem để khóa vĩnh viễn
+        localStorage.setItem('dua_aftercredit_viewed', 'true');
+        localStorage.removeItem('dua_aftercredit_unlocked_by_password');
+        localStorage.removeItem('dua_aftercredit_lp_unlocked_confirmed');
+        
+        const lines = text.replace(/\r\n/g, '\n').split('\n');
+        let currentParagraph = [];
+        
+        for (let i = 0; i < lines.length; i++) {
+            const line = lines[i].trim();
+            if (line === '') {
+                if (currentParagraph.length > 0) {
+                    const p = document.createElement('p');
+                    p.innerHTML = currentParagraph.join('<br>');
+                    container.appendChild(p);
+                    currentParagraph = [];
+                }
+            } else {
+                currentParagraph.push(line);
+            }
+        }
+        
+        if (currentParagraph.length > 0) {
+            const p = document.createElement('p');
+            p.innerHTML = currentParagraph.join('<br>');
+            container.appendChild(p);
+        }
+
+        // Đăng ký theo dõi sự kiện cuộn để xác nhận streamer đã đọc hết thư
+        localStorage.removeItem('dua_aftercredit_read_fully'); // Reset trạng thái trước khi đọc
+        
+        container.addEventListener('scroll', () => {
+            if (container.scrollHeight - container.scrollTop <= container.clientHeight + 25) {
+                localStorage.setItem('dua_aftercredit_read_fully', 'true');
+            }
+        });
+
+        // Nếu chiều cao thư ngắn hơn khung hiển thị (không xuất hiện thanh cuộn), tự động tính là đã đọc hết
+        if (container.scrollHeight <= container.clientHeight) {
+            localStorage.setItem('dua_aftercredit_read_fully', 'true');
+        }
+
+        // Áp dụng các sự kiện bảo mật chặn kéo chọn, chuột phải, copy-paste
+        applyAfterCreditSecurity();
+    } catch (err) {
+        console.error('Lỗi khi tải nội dung After Credit:', err);
+        if (container) {
+            container.innerHTML = '<p>Lỗi tải nội dung thư After Credit.</p>';
+        }
+    }
+}
+
+// --- BẬT / TẮT DARK MODE DASHBOARD ---
+function toggleDarkMode(isDark) {
+    if (isDark) {
+        document.body.classList.add('dark-mode');
+        localStorage.setItem('dua_dark_mode', 'true');
+    } else {
+        document.body.classList.remove('dark-mode');
+        localStorage.setItem('dua_dark_mode', 'false');
+    }
+    const switchEl = document.getElementById('dark-mode-toggle-switch');
+    if (switchEl) {
+        switchEl.checked = isDark;
+    }
+}
+
+// --- ÁP DỤNG TRẠNG THÁI VÔ HIỆU HÓA HOẠT ĐỘNG KHI BẬT FOCUS MODE ---
+function applyDashboardFocusModeState(enabled) {
+    if (enabled) {
+        document.body.classList.add('focus-mode-active');
+    } else {
+        document.body.classList.remove('focus-mode-active');
+    }
+
+    const selectors = [
+        '#btn-play-pause',
+        '#btn-skip',
+        '#btn-bypass-limit',
+        '#progress-slider',
+        '#volume-slider',
+        '#card-quick-add input',
+        '#card-quick-add button',
+        '#card-youtube-dashboard select',
+        '#card-youtube-dashboard button',
+        '#card-time-limit input',
+        '#card-time-limit button',
+        '#queue-sort-select',
+        '#btn-test-mode'
+    ].join(', ');
+
+    const elements = document.querySelectorAll(selectors);
+    elements.forEach(el => {
+        if (el.id !== 'focus-mode-toggle-switch') {
+            el.disabled = enabled;
+        }
+    });
+}
+
+// --- BẬT / TẮT CHẾ ĐỘ TẬP TRUNG (FOCUS MODE) ---
+function toggleFocusMode(enabled) {
+    state.focusMode = enabled;
+    localStorage.setItem('dua_focus_mode', enabled);
+    publishMqtt('focus_mode', { value: enabled });
+    
+    applyDashboardFocusModeState(enabled);
+    
+    if (enabled) {
+        logSystem("Đã BẬT chế độ Tập trung: Tạm dừng tự động chuyển bài khi có nhạc mới.", "system");
+        showDashboardSystemAlert("Chế độ Tập trung", "Đã BẬT: Hàng đợi sẽ được giữ lại, không tự động phát bài mới.");
+        
+        // Tạm dừng bài hát đang phát nếu có
+        if (state.currentSong && state.isPlaying) {
+            state.wasPlayingBeforeFocusMode = true;
+            sendControlCommand('pause');
+            state.isPlaying = false;
+            updatePlayPauseButtonUI(false);
+            logSystem("Tự động tạm dừng bài hát hiện tại do kích hoạt Chế độ Tập trung.", "system");
+        } else {
+            state.wasPlayingBeforeFocusMode = false;
+        }
+    } else {
+        logSystem("Đã TẮT chế độ Tập trung.", "system");
+        showDashboardSystemAlert("Chế độ Tập trung", "Đã TẮT.");
+        
+        // Nếu trước đó bài hát đang phát dở bị tạm dừng do Focus Mode, tự động phát lại
+        if (state.currentSong && state.wasPlayingBeforeFocusMode) {
+            sendControlCommand('play');
+            state.isPlaying = true;
+            updatePlayPauseButtonUI(true);
+            logSystem("Tự động tiếp tục phát lại bài hát đang phát dở sau khi TẮT Chế độ Tập trung.", "system");
+        }
+        state.wasPlayingBeforeFocusMode = false;
+    }
+}
+
+// --- CẬP NHẬT NÚT VÔ CÙNG (BYPASS LIMIT) TRÊN PLAYER CONTROL ---
+function updateBypassButtonUI() {
+    const btn = document.getElementById('btn-bypass-limit');
+    if (!btn) return;
+    
+    if (state.currentSong) {
+        btn.style.display = 'inline-flex';
+        if (state.bypassCurrentSongDuration) {
+            btn.classList.add('active-bypass');
+            btn.title = "Đang phát hết bài (không giới hạn)";
+        } else {
+            btn.classList.remove('active-bypass');
+            btn.title = "Phát hết bài hát này (bỏ qua giới hạn thời gian)";
+        }
+    } else {
+        btn.style.display = 'none';
+    }
+}
+
+// --- HIỂN THỊ THÔNG BÁO DONATE MỚI TRÊN DASHBOARD ---
