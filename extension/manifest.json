{
  "manifest_version": 3,
  "name": "Pineapple Studio Remote",
  "version": "1.1.2",
  "description": "Đồng bộ media đang phát và gửi nhạc từ trình duyệt sang Pineapple Studio.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://soundcloud.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://soundcloud.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
