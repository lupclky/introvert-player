{
  "name": "introvert-player",
  "version": "2.0.3",
  "description": "Introvert Player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "author": "Introvert",
  "license": "ISC",
  "build": {
    "appId": "com.introvert.player",
    "productName": "IntrovertPlayer",
    "publish": null,
    "directories": {
      "output": "dist-v2"
    },
    "files": [
      "index.html",
      "overlay.html",
      "app.js",
      "styles.css",
      "main.js",
      "preload.js",
      "package.json",
      "asset",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Introvert Player"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  }
}